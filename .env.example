# ─────────────────────────────────────────────────────────────
# Second Brain — environment template. Copy to .env and fill in.
# NEVER commit the real .env. Secrets live only in the environment.
# ─────────────────────────────────────────────────────────────

# ── API ──
NODE_ENV=development
API_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8083

# One-time admin migration bridge. Persistent AdminRoleAssignment rows are the
# authority after bootstrap; disable in production after the initial grant.
ADMIN_EMAILS=
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_STEP_UP_TTL=600
ADMIN_SESSION_MAX_TTL=28800
ADMIN_ENVIRONMENT=development

# ── PostgreSQL (matches docker-compose.yml) ──
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=replace_with_local_postgres_password
POSTGRES_DB=secondbrain
# Prisma connection string (host is localhost when the API runs on the host)
DATABASE_URL=postgresql://secondbrain:replace_with_local_postgres_password@localhost:5432/secondbrain?schema=public

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Qdrant ──
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=          # only needed for Qdrant Cloud

# ── LLM abstraction layer ──
# Which provider the app talks to. One of: gemini | openai | claude | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-pro
GEMINI_API_KEY=

# ── Embeddings (Learning Memory Engine) ──
# Provider: gemini | fake (fake = deterministic local vectors, no API key needed)
EMBEDDINGS_PROVIDER=fake
# gemini-embedding-001 is requested at 768 dimensions (see GeminiEmbeddingsProvider)
EMBEDDINGS_MODEL=gemini-embedding-001

# ── Speech / voice layer (Phase 5) ──
# Provider: gemini | fake
#   gemini = real STT (audio in) + real TTS (audio out)
#   fake   = deterministic offline dev transport: the uploaded payload is read as
#            UTF-8 text and returned as the transcript. No TTS (a silent WAV
#            would be a placeholder) — `speak:true` then returns 501.
SPEECH_PROVIDER=fake
# Audio-in runs on the regular multimodal models; TTS needs a dedicated *-tts model.
SPEECH_STT_MODEL=gemini-flash-lite-latest
SPEECH_TTS_MODEL=gemini-2.5-flash-preview-tts
# Prebuilt Gemini voice name (Kore, Puck, Charon, Fenrir, Aoede…).
SPEECH_VOICE=Kore

# ── Auth (Phase 1) ──
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=900          # 15 minutes (seconds)
JWT_REFRESH_TTL=1209600     # 14 days (seconds)
EMAIL_VERIFICATION_TTL=86400  # 24 hours (seconds)
TWO_FACTOR_CHALLENGE_TTL=300  # 5 minutes (seconds) — 2FA login step-up window
OTP_TTL=600                   # 10 minutes (seconds)
OTP_MAX_ATTEMPTS=5
# Key for encrypting TOTP secrets at rest (AES-256-GCM). Falls back to the access
# secret if unset; set an explicit 32+ char value in production.
# TWO_FACTOR_ENC_KEY=

# ── Daily journey notifications (Phase 5) ──
# Transport for the daily-journey nudges. One of:
#   log  = print to the API console (dev)
#   mail = deliver as email, riding MAIL_TRANSPORT below (no duplicate transport)
#   smtp = legacy alias for mail (prefer mail in new environments)
# A learner's slots fire on THEIR timezone (Profile.timezone, PUT /api/journey/settings).
NOTIFY_TRANSPORT=log

# ── Mail ──
# Transport for outbound email. 'log' (dev) prints messages to the API console.
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@secondbrain.local
# Base URL used to build links inside emails (verification, etc.).
APP_URL=http://localhost:3000

# SMTP fields are only required when MAIL_TRANSPORT=smtp.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=

# ── Billing ──
# fake is accepted only in development/test. Production must explicitly use stripe.
PAYMENT_PROVIDER=fake
APP_PUBLIC_URL=http://localhost:8082
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mobile store integrations remain fail-closed until their full server-side
# product/account verification is configured and enabled.
APPLE_SHARED_SECRET=
GOOGLE_PLAY_SERVICE_ACCOUNT=

# ── Administration ──
# Comma-separated bootstrap admin emails. Prefer the persisted isAdmin flag.
ADMIN_EMAILS=

# ── UX rollout flags (UX-2) ──
# Operational rollout only; these are not subscription entitlements. Keep false
# until the corresponding implementation lot is explicitly validated.
FEATURE_NEW_APP_SHELL=false
FEATURE_EXPERIENCE_SESSIONS=false
FEATURE_UNIVERSAL_COMPOSER=false
FEATURE_NEW_HOME_NBA=false
FEATURE_NEW_BRAIN=false
FEATURE_DOCUMENT_INTELLIGENCE=false
FEATURE_NEW_TUTOR_EXPERIENCE=false
FEATURE_NEW_LANDING=false

# Expo embeds only EXPO_PUBLIC_* values in the client bundle. Never put secrets here.
# Optional public support address shown on the Landing contact section. Leave empty
# until a monitored mailbox exists; the UI will not pretend to send a message.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_FEATURE_NEW_APP_SHELL=false
# Optional comma-separated metadata paths for a route-by-route shell rollout.
# Empty means every eligible route once the flag above is true. Example:
# EXPO_PUBLIC_NEW_APP_SHELL_ROUTES=/,/learn,/library,/library/[id]
EXPO_PUBLIC_NEW_APP_SHELL_ROUTES=
EXPO_PUBLIC_FEATURE_EXPERIENCE_SESSIONS=false
EXPO_PUBLIC_FEATURE_UNIVERSAL_COMPOSER=false
EXPO_PUBLIC_FEATURE_NEW_HOME_NBA=false
EXPO_PUBLIC_FEATURE_NEW_BRAIN=false
EXPO_PUBLIC_FEATURE_DOCUMENT_INTELLIGENCE=false
EXPO_PUBLIC_FEATURE_NEW_TUTOR_EXPERIENCE=false
EXPO_PUBLIC_FEATURE_NEW_LANDING=false
