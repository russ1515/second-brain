# ─────────────────────────────────────────────────────────────
# Second Brain — environment template. Copy to .env and fill in.
# NEVER commit the real .env. Secrets live only in the environment.
# ─────────────────────────────────────────────────────────────

# ── API ──
NODE_ENV=development
API_PORT=3000

# ── PostgreSQL (matches docker-compose.yml) ──
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=secondbrain_dev_pw
POSTGRES_DB=secondbrain
# Prisma connection string (host is localhost when the API runs on the host)
DATABASE_URL=postgresql://secondbrain:secondbrain_dev_pw@localhost:5432/secondbrain?schema=public

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Qdrant ──
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=          # only needed for Qdrant Cloud

# ── LLM abstraction layer ──
# Which provider the app talks to. One of: gemini | openai | claude | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-pro
GEMINI_API_KEY=

# ── Embeddings (Learning Memory Engine) ──
# Provider: gemini | fake (fake = deterministic local vectors, no API key needed)
EMBEDDINGS_PROVIDER=fake
# gemini-embedding-001 is requested at 768 dimensions (see GeminiEmbeddingsProvider)
EMBEDDINGS_MODEL=gemini-embedding-001

# ── Speech / voice layer (Phase 5) ──
# Provider: gemini | fake
#   gemini = real STT (audio in) + real TTS (audio out)
#   fake   = deterministic offline dev transport: the uploaded payload is read as
#            UTF-8 text and returned as the transcript. No TTS (a silent WAV
#            would be a placeholder) — `speak:true` then returns 501.
SPEECH_PROVIDER=fake
# Audio-in runs on the regular multimodal models; TTS needs a dedicated *-tts model.
SPEECH_STT_MODEL=gemini-flash-lite-latest
SPEECH_TTS_MODEL=gemini-2.5-flash-preview-tts
# Prebuilt Gemini voice name (Kore, Puck, Charon, Fenrir, Aoede…).
SPEECH_VOICE=Kore

# ── Auth (Phase 1) ──
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=900          # 15 minutes (seconds)
JWT_REFRESH_TTL=1209600     # 14 days (seconds)
EMAIL_VERIFICATION_TTL=86400  # 24 hours (seconds)
TWO_FACTOR_CHALLENGE_TTL=300  # 5 minutes (seconds) — 2FA login step-up window
# Key for encrypting TOTP secrets at rest (AES-256-GCM). Falls back to the access
# secret if unset; set an explicit 32+ char value in production.
# TWO_FACTOR_ENC_KEY=

# ── Daily journey notifications (Phase 5) ──
# Transport for the daily-journey nudges. One of:
#   log  = print to the API console (dev)
#   mail = deliver as email, riding MAIL_TRANSPORT below (no duplicate transport)
# A learner's slots fire on THEIR timezone (Profile.timezone, PUT /api/journey/settings).
NOTIFY_TRANSPORT=log

# ── Mail ──
# Transport for outbound email. 'log' (dev) prints messages to the API console.
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@secondbrain.local
# Base URL used to build links inside emails (verification, etc.).
APP_URL=http://localhost:3000
