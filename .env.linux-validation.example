# This file documents the variable shape and validates Compose parsing only.
# The supported executable entrypoint is scripts/start-linux-pg-validation.ps1,
# which generates the project, run id, database name and test-only password.
# Never reuse a production credential or a production database name.
SB_LINUX_VALIDATION_POSTGRES_USER=secondbrain_validation
SB_LINUX_VALIDATION_POSTGRES_PASSWORD=replace_with_a_unique_test_only_value
SB_LINUX_VALIDATION_POSTGRES_DB=second_brain_sprint5_test_20260918000000deadbeef
SPRINT5_VALIDATION_REPEATS=3
SB_LINUX_VALIDATION_FRESH_DATABASE=I_CONFIRM_FRESH_VALIDATION_DATABASE
SB_LINUX_VALIDATION_RUN_ID=20260918000000-deadbeef
SB_LINUX_VALIDATION_COMPOSE_MARKER=SECOND_BRAIN_LINUX_VALIDATION
