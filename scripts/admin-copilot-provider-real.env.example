# Add the selector below to the existing owner-only VPS provider file:
#   $P1_DIR/private/provider-real.env
# Keep the file mode 0600 and its parent directory mode 0700. The existing
# OpenAI key remains there; it is never committed, copied to Expo, baked into
# an image, printed, or stored as evidence.
#
# Do not set LLM_PROVIDER here. The disposable Compose overlay selects OpenAI;
# the persistent P1 service remains independently configured.
# OPENAI_API_KEY is already present in provider-real.env.
# Exact approved model for the Admin Copilot provider call. This is the sole
# model selector for the gate; it is mapped to OPENAI_MODEL inside the temporary
# API container without adding a hardcoded model to source.
ADMIN_COPILOT_MODEL=
# Optional output cap for the disposable one-call provider gate: 1..128.
OPENAI_PROVIDER_GATE_MAX_OUTPUT_TOKENS=32
