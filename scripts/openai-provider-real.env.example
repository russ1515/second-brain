# Copy this template only to the owner-only VPS path:
#   $P1_DIR/private/provider-real.env
# Keep that file mode 0600 and its parent directory mode 0700. It is never
# committed and must not be copied into Expo, images, evidence, or logs.
#
# Do not set LLM_PROVIDER here. The reviewed persistent Compose overlay selects
# OpenAI while this owner-only file supplies only the private credential and
# exact model. Echo remains available for explicit dev/test deployments.
OPENAI_API_KEY=
# Exact approved OpenAI model. It is read only by the server-side OpenAI seam.
OPENAI_MODEL=
# Optional speech overrides. The persistent beta overlay supplies the reviewed
# defaults when these are absent; keeping them here documents the private
# deployment seam without exposing any credential.
SPEECH_STT_MODEL=gpt-4o-mini-transcribe
SPEECH_TTS_MODEL=gpt-4o-mini-tts
SPEECH_VOICE=marin
# Optional hard cap for the one-call staging gate; accepted range: 1..128.
OPENAI_PROVIDER_GATE_MAX_OUTPUT_TOKENS=32
