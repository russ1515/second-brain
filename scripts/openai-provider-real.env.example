# Copy this template only to the owner-only VPS path:
#   $P1_DIR/private/provider-real.env
# Keep that file mode 0600 and its parent directory mode 0700. It is never
# committed and must not be copied into Expo, images, evidence, or logs.
#
# Do not set LLM_PROVIDER here. The one-off Compose override selects OpenAI;
# the persistent P1 service remains LLM_PROVIDER=echo until separate activation
# authorization is given.
OPENAI_API_KEY=
# Existing project convention: exact approved OpenAI model used by LLM_MODEL.
LLM_MODEL=
# Optional hard cap for the one-call staging gate; accepted range: 1..128.
OPENAI_PROVIDER_GATE_MAX_OUTPUT_TOKENS=32
