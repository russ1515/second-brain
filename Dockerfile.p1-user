FROM node:22-alpine AS build

ARG EXPO_PUBLIC_FEATURE_NEW_APP_SHELL=false
ARG EXPO_PUBLIC_FEATURE_NEW_LANDING=false

RUN corepack enable && corepack prepare pnpm@11.13.1 --activate
WORKDIR /workspace

# Expo/Metro needs the same reproducible hoisted topology for both the frozen
# filtered install and the later export. Do not relax the lockfile check.
ENV CI=true \
    EXPO_NO_DOTENV=1 \
    EXPO_NO_TELEMETRY=1 \
    EXPO_PUBLIC_FEATURE_NEW_APP_SHELL=${EXPO_PUBLIC_FEATURE_NEW_APP_SHELL} \
    EXPO_PUBLIC_FEATURE_NEW_LANDING=${EXPO_PUBLIC_FEATURE_NEW_LANDING} \
    PNPM_CONFIG_NODE_LINKER=hoisted \
    PNPM_CONFIG_TRUST_LOCKFILE=true

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/mobile/package.json apps/mobile/package.json

RUN pnpm --config.node-linker=hoisted --config.trust-lockfile=true \
    --filter @second-brain/mobile... install --frozen-lockfile

COPY packages/shared packages/shared
COPY apps/mobile apps/mobile

RUN pnpm --filter @second-brain/shared build \
 && pnpm --filter @second-brain/mobile typecheck \
 && pnpm --filter @second-brain/mobile run export:web

FROM nginx:1.27-alpine

COPY deploy/nginx/p1-user.conf /etc/nginx/nginx.conf
COPY --from=build /workspace/apps/mobile/dist /usr/share/nginx/html

# Git worktrees used for private releases may be created under a restrictive
# umask. Expo can preserve that mode on generated files, so normalize the
# static tree explicitly instead of letting Nginx return 403 for unreadable
# assets. No file in this image contains a runtime secret.
RUN find /usr/share/nginx/html -type d -exec chmod 0755 {} + \
 && find /usr/share/nginx/html -type f -exec chmod 0644 {} + \
 && nginx -t

EXPOSE 8082
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8082/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
