}

/// Internal Support/Admin note.  It is deliberately separate from learner
/// content and always attributed to the administrator who wrote it.
model AdminSupportNote {
  id        String   @id @default(cuid())
  userId    String
  actorId   String
  body      String
  createdAt DateTime @default(now())

  user  User @relation("AdminSupportNotesForUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("AdminSupportNotesByActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("admin_support_notes")
}

/// Traceable administrative review of a learner profile.  Requesting a user
/// update is recorded here even when delivery is not yet instrumented.
model AdminProfileReview {
  id             String   @id @default(cuid())
  userId         String
  adminId        String
  action         String
  reason         String
  deliveryStatus String   @default("NOT_APPLICABLE")
  createdAt      DateTime @default(now())

  user  User @relation("AdminProfileReviewsForUser", fields: [userId], references: [id], onDelete: Cascade)
  admin User @relation("AdminProfileReviewsByActor", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("admin_profile_reviews")
}

model PlanVersion {
  id            String    @id @default(cuid())
  planId        String
  version       Int
  priceMonthly  Int?
  priceYearly   Int?
  currency      String
  quotas        Json
  features      Json
  fallbackRatio Float     @default(0.5)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  publishedAt   DateTime  @default(now())
  createdById   String?
  reason        String?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, version])
  @@index([planId, effectiveFrom])
  @@map("plan_versions")
}

enum QuotaResource {
  AI_TEXT
  VOICE_SECONDS
  DOCUMENT_PAGES
  OCR_PAGES
  EMBEDDING_UNITS
  WEB_SEARCH
  DEEP_RESEARCH
  ACADEMIC_AI
}

enum QuotaCycleStatus {
  ACTIVE
  CLOSED
}

model QuotaCycle {
  id             String           @id @default(cuid())
  userId         String
  subscriptionId String?
  planSlug       String
  planVersion    Int
  startsAt       DateTime
  endsAt         DateTime
  status         QuotaCycleStatus @default(ACTIVE)
  source         String
  predecessorId  String?
  createdAt      DateTime         @default(now())
  closedAt       DateTime?

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts     QuotaAccount[]
  reservations QuotaReservation[]

  @@unique([userId, startsAt, endsAt])
  @@index([userId, status, startsAt, endsAt])
  @@index([status, startsAt, endsAt])
  @@map("quota_cycles")
}

enum QuotaState {
  PRIMARY
  FALLBACK
  BLOCKED
}

model QuotaAccount {
  id            String        @id @default(cuid())
  cycleId       String
  resource      QuotaResource
  primaryLimit  Int?
  fallbackLimit Int           @default(0)
  primaryUsed   Int           @default(0)
  fallbackUsed  Int           @default(0)
  state         QuotaState    @default(PRIMARY)
  version       Int           @default(0)
  updatedAt     DateTime      @updatedAt

  cycle        QuotaCycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  reservations QuotaReservation[]

  @@unique([cycleId, resource])
  @@index([cycleId, state])
  @@map("quota_accounts")
}

enum QuotaReservationStatus {
  RESERVED
  FINALIZED
  RELEASED
}

model QuotaReservation {
  id             String                 @id @default(cuid())
  idempotencyKey String
  userId         String
  cycleId        String
  accountId      String
  resource       QuotaResource
  feature        String
  requestedUnits Int
  primaryUnits   Int                    @default(0)
  fallbackUnits  Int                    @default(0)
  actualUnits    Int?
  status         QuotaReservationStatus @default(RESERVED)
  createdAt      DateTime               @default(now())
  completedAt    DateTime?

  cycle                   QuotaCycle               @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  account                 QuotaAccount             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  ledger                  UsageLedger[]
  providerUsage           ProviderUsage?
  providerUsageOperations ProviderUsageOperation[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("quota_reservations")
}

enum UsageLedgerEvent {
  RESERVE
  FINALIZE
  RELEASE
  ADJUST
}

model UsageLedger {
  id             String           @id @default(cuid())
  reservationId  String?
  userId         String
  cycleId        String
  resource       QuotaResource
  event          UsageLedgerEvent
  primaryDelta   Int              @default(0)
  fallbackDelta  Int              @default(0)
  actualUnits    Int?
  actorId        String?
  reason         String?
  idempotencyKey String           @unique
  metadata       Json?
  createdAt      DateTime         @default(now())

  reservation QuotaReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([userId, cycleId, resource, createdAt])
  @@map("usage_ledger")
}

model ProviderUsage {
  id                  String        @id @default(cuid())
  userId              String
  subscriptionId      String?
  planSlug            String
  planVersion         Int
  feature             String
  resource            QuotaResource
  provider            String
  model               String?
  requestId           String
  internalOperationId String        @unique
  status              String
  inputTokens         Int?
  outputTokens        Int?
  cachedTokens        Int?
  audioInputSeconds   Int?
  audioOutputSeconds  Int?
  pages               Int?
  searchCount         Int?
  providerCostMinor   Int?
  providerCurrency    String?
  pricingVersion      String?
  latencyMs           Int?
  metadata            Json?
  startedAt           DateTime      @default(now())
  completedAt         DateTime?
  reservationId       String?       @unique

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation QuotaReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([provider, model, startedAt])
  @@index([startedAt, resource, status])
  @@map("provider_usage")
}

model ProviderPricing {
  id               String    @id @default(cuid())
  provider         String
  model            String
  version          String
  currency         String
  inputTokenPrice  Float?
  outputTokenPrice Float?
  audioSecondPrice Float?
  pagePrice        Float?
  searchPrice      Float?
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  createdAt        DateTime  @default(now())

  @@unique([provider, model, version])
  @@map("provider_pricing")
}

// ── Sprint 4: provider usage & cost ledger ─────────────────────────────────
//
// ProviderUsage above remains the backwards-compatible logical envelope used
// by earlier Admin surfaces.  The tables below are the financial source of
// truth: each immutable final attempt carries its precise usage, the price
// snapshot that was applicable at the time, and an explicit confidence state.

enum ProviderUsageOperationStatus {
  STARTED
  SUCCEEDED
  FAILED
  FINALIZATION_PENDING
  BLOCKED
}

enum ProviderUsageAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum ProviderCostStatus {
  MEASURED
  ESTIMATED
  UNKNOWN
  NOT_AVAILABLE
  NOT_INSTRUMENTED
}

enum ProviderPricingStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ProviderCostAdjustmentKind {
  CORRECTION
  RECONCILIATION
}

/**
 * One user-intended logical operation.  An operation is deliberately separate
 * from individual attempts: a retry is visible and billable independently but
 * still rolls up to the one action that initiated it.
 */
model ProviderUsageOperation {
  id                 String                       @id @default(cuid())
  idempotencyKey     String                       @unique
  requestId          String?
  userId             String?
  subscriptionId     String?
  planSlug           String?
  planVersion        Int?
  feature            String
  resource           QuotaResource?
  quotaReservationId String?
  quotaState         QuotaState?
  status             ProviderUsageOperationStatus @default(STARTED)
  unattributedReason String?
  metadata           Json?
  startedAt          DateTime                     @default(now())
  completedAt        DateTime?

  user             User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  quotaReservation QuotaReservation?        @relation(fields: [quotaReservationId], references: [id], onDelete: SetNull)
  attempts         ProviderUsageAttempt[]
  adjustments      ProviderCostAdjustment[]

  @@index([startedAt, status])
  @@index([userId, startedAt])
  @@index([planSlug, feature, startedAt])
  @@index([quotaState, startedAt])
  @@map("provider_usage_operations")
}

/**
 * A provider call attempt.  Once finalized, it is never repriced or mutated.
 */
model ProviderUsageAttempt {
  id                 String                     @id @default(cuid())
  operationId        String
  attemptNumber      Int
  attemptId          String                     @unique
  providerRequestId  String?                    @unique
  provider           String
  model              String?
  status             ProviderUsageAttemptStatus @default(STARTED)
  costStatus         ProviderCostStatus         @default(NOT_INSTRUMENTED)
  measurementSource  String                     @default("PROVIDER")
  inputTokens        Int?
  cachedInputTokens  Int?
  outputTokens       Int?
  reasoningTokens    Int?
  audioInputSeconds  Int?
  audioOutputSeconds Int?
  ocrPages           Int?
  visionCalls        Int?
  embeddingUnits     Int?
  searchUnits        Int?
  otherUnits         Int?
  originalAmount     Decimal?                   @db.Decimal(20, 12)
  originalCurrency   String?
  referenceAmountUsd Decimal?                   @db.Decimal(20, 12)
  fxRate             Decimal?                   @db.Decimal(20, 12)
  fxRateSource       String?
  fxRateTimestamp    DateTime?
  pricingVersionId   String?
  pricingVersion     String?
  pricingSnapshot    Json?
  latencyMs          Int?
  errorCode          String?
  metadata           Json?
  startedAt          DateTime                   @default(now())
  completedAt        DateTime?
  finalizedAt        DateTime?

  operation   ProviderUsageOperation   @relation(fields: [operationId], references: [id], onDelete: Cascade)
  adjustments ProviderCostAdjustment[]
  errorEvents ErrorEvent[]

  @@unique([operationId, attemptNumber])
  @@index([provider, model, startedAt])
  @@index([costStatus, startedAt])
  @@index([operationId, startedAt])
  @@map("provider_usage_attempts")
}

/**
 * Immutable correction/reconciliation entries.  They are intentionally not a
 * mutable column on ProviderUsageAttempt so a historical provider calculation
 * can always be reproduced and audited.
 */
model ProviderCostAdjustment {
  id               String                     @id @default(cuid())
  operationId      String
  attemptId        String?
  kind             ProviderCostAdjustmentKind
  amountDeltaUsd   Decimal?                   @db.Decimal(20, 12)
  originalAmount   Decimal?                   @db.Decimal(20, 12)
  originalCurrency String?
  reason           String
  createdById      String?
  metadata         Json?
  createdAt        DateTime                   @default(now())

  operation ProviderUsageOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  attempt   ProviderUsageAttempt?  @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([operationId, createdAt])
  @@index([attemptId, createdAt])
  @@map("provider_cost_adjustments")
}

/**
 * Versioned provider price catalog.  Rates are Decimal amounts per named unit,
 * never Float.  A finalized attempt stores its own snapshot, so later catalog
 * versions never recalculate history.
 */
model ProviderPricingVersion {
  id                     String                @id @default(cuid())
  provider               String
  model                  String
  version                String
  status                 ProviderPricingStatus @default(DRAFT)
  currency               String
  inputTokenPrice        Decimal?              @db.Decimal(20, 12)
  cachedInputTokenPrice  Decimal?              @db.Decimal(20, 12)
  outputTokenPrice       Decimal?              @db.Decimal(20, 12)
  reasoningTokenPrice    Decimal?              @db.Decimal(20, 12)
  audioInputSecondPrice  Decimal?              @db.Decimal(20, 12)
  audioOutputSecondPrice Decimal?              @db.Decimal(20, 12)
  ocrPagePrice           Decimal?              @db.Decimal(20, 12)
  visionCallPrice        Decimal?              @db.Decimal(20, 12)
  embeddingUnitPrice     Decimal?              @db.Decimal(20, 12)
  searchUnitPrice        Decimal?              @db.Decimal(20, 12)
  otherUnitPrice         Decimal?              @db.Decimal(20, 12)
  otherUnitName          String?
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  sourceReference        String?
  createdById            String?
  reason                 String?
  createdAt              DateTime              @default(now())

  @@unique([provider, model, version])
  @@index([provider, model, status, effectiveFrom])
  @@map("provider_pricing_versions")
}

/**
 * Config-only financial guardrail.  It drives observation and alerts, never quotas or routing.
 */
model ProviderCostBudget {
  id               String   @id @default(cuid())
  scope            String
  scopeKey         String?
  currency         String   @default("USD")
  monthlyAmountUsd Decimal  @db.Decimal(20, 12)
  warningPercent   Int      @default(80)
  criticalPercent  Int      @default(100)
  reason           String
  createdById      String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([scope, scopeKey, active])
  @@map("provider_cost_budgets")
}

model EntitlementOverride {
  id          String    @id @default(cuid())
  userId      String
  kind        String
  key         String
  value       Json
  reason      String
  grantedById String
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  revokedAt   DateTime?
  revokedById String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt, endsAt, revokedAt])
  @@map("entitlement_overrides")
}

enum ReportStatus {
  open
  reviewed
  dismissed
}

/// A user-submitted report / flag (abuse, bug, content). Admins triage these.
model Report {
  id                           String                  @id @default(cuid())
  reporterId                   String?
  /// Free category, e.g. "content" | "bug" | "abuse".
  category                     String                  @default("other")
  /// Always redacted/truncated by the reporting service before persistence.
  message                      String
  status                       ReportStatus            @default(open)
  /// Request that submitted this report. It is distinct from the observed
  /// failing request retained below for evidence-only correlation.
  requestId                    String?
  observedRequestId            String?
  operationId                  String?
  route                        String?
  feature                      String?
  appVersion                   String?
  buildVersion                 String?
  platform                     String?
  environment                  String?
  consentAdditionalDiagnostics Boolean                 @default(false)
  correlationStatus            ReportCorrelationStatus @default(independent)
  correlationConfidence        DiagnosticConfidence    @default(unconfirmed)
  bugGroupId                   String?
  linkedAt                     DateTime?
  linkedById                   String?
  createdAt                    DateTime                @default(now())
  reviewedAt                   DateTime?

  bugGroup     BugGroup?     @relation(fields: [bugGroupId], references: [id], onDelete: SetNull)
  supportCases SupportCase[]

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([requestId, createdAt])
  @@index([observedRequestId, createdAt])
  @@index([bugGroupId, status])
  @@map("reports")
}

// ── Organizations & multi-tenancy (Sprint 8.4) ──

enum OrganizationType {
  school
  university
  training_center
  enterprise
}

/// Role of a user WITHIN an organization. Coarse by design; finer per-group
/// roles live on GroupMember.
enum OrgRole {
  admin
  teacher
  student
}

enum OrgGroupKind {
  class
  group
}

/// A tenant. All org-scoped data hangs off this and is isolated: a user can only
/// reach an organization they are a member of (enforced in the service layer).
model Organization {
  id        String           @id @default(cuid())
  name      String
  type      OrganizationType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  memberships Membership[]
  groups      OrgGroup[]

  @@map("organizations")
}

/// A user's membership of an organization, with an org-level role. The unique
/// (org,user) pair is the isolation key every org query filters on.
model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(student)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

/// A class or a generic group inside an organization.
model OrgGroup {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  kind           OrgGroupKind @default(class)
  createdAt      DateTime     @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      GroupMember[]

  @@index([organizationId])
  @@map("org_groups")
}

/// Membership of a class/group (teacher or student of that group).
model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      OrgRole  @default(student)
  createdAt DateTime @default(now())

  group OrgGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

/// A directed edge between two concepts (prerequisite / related).
model ConceptEdge {
  id        String          @id @default(cuid())
  userId    String
  sourceId  String
  targetId  String
  relation  ConceptRelation
  createdAt DateTime        @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  source Concept @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Concept @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relation])
  @@index([userId])
  @@index([sourceId])
  @@index([targetId])
  @@map("concept_edges")
}
