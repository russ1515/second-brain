enum DeletionRequestStatus {
  requested
  approved
  rejected
  completed
}

model AccountDeletionRequest {
  id            String                @id @default(cuid())
  userId        String
  requestedById String
  approvedById  String?
  reason        String
  status        DeletionRequestStatus @default(requested)
